# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public app URL (local or deployed). Used for Stripe redirects.
APP_URL="http://localhost:3000"

# Optional absolute API base. Leave empty in production so Firebase Hosting
# rewrites /api/** to Cloud Run (same-origin). Override only if needed:
# VITE_API_BASE_URL=https://stocktrend-ai-357117913612.us-central1.run.app

FINNHUB_API_KEY=your_finnhub_api_key_here

# TWELVE_DATA_API_KEY: Optional. Premium real-time market data.
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# MARKETAUX_API_KEY: Optional. News and sentiment.
MARKETAUX_API_KEY=your_marketaux_api_key_here

# Stripe — plans (MYR)
# Basic: RM 199/mo · 20 analyses + 20 news / day
# Pro:   RM 349/mo · 30 analyses + 30 news / day
# Overage (all plans): RM 5 mini (+5 analyses / +10 news)
#                      RM 10 Reload pack (+10 analyses +10 news, lasts until used)
# Stripe MYR checkout minimum is RM 2 — minis are priced at RM 5.
# Overage checkout uses inline price_data when catalog price ids are unset.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
# Optional catalog prices (otherwise RM amounts are created inline):
# STRIPE_PRICE_ANALYSIS_OVERAGE=price_...
# STRIPE_PRICE_NEWS_OVERAGE=price_...
# STRIPE_PRICE_RELOAD_PACK=price_...
# Legacy analysis-only pack (kept for old checkout sessions):
# STRIPE_PRICE_ANALYSIS_PACK=price_...
# Optional legacy yearly price (not offered on pricing page)
# STRIPE_PRICE_YEARLY=price_...

# Firebase Admin — required for Stripe webhooks to update users.subscriptionStatus
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json
FIREBASE_PROJECT_ID=stocktrend-ai-super

# INTERNAL_JOB_SECRET: shared secret for the daily Cloud Scheduler call to
# POST /api/internal/evaluate-outcomes (sent as the x-internal-secret header).
# Generate with: openssl rand -hex 32
INTERNAL_JOB_SECRET=
